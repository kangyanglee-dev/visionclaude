ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
PORT=18790
# Bind to one specific address. Keep loopback for local-only use; set the
# workstation's LAN IP explicitly only when the iPhone needs LAN access.
GATEWAY_HOST=127.0.0.1
# Must match the key entered in iOS Settings → Channel / Gateway Key.
GATEWAY_API_KEY=replace-with-channel-token
# Trial-safe mode is enabled unless explicitly set to 0. It disables MCP
# discovery/tools and external skill search.
VISIONCLAUDE_TRIAL_SAFE_MODE=1
# MCP_CONFIG_PATH is ignored while trial-safe mode is enabled.
# MCP_CONFIG_PATH=/path/to/mcp-config.json
# Optional: legacy model override, used only when ANTHROPIC_MODEL is unset.
# CLAUDE_MODEL=claude-sonnet-4-20250514
